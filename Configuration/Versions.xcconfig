// Versions.xcconfig — Single source of truth for all version and build numbers.
//
// This file is the ONLY place version/build values should be edited.
// Updated by: scripts/release-set-version.sh
// Read at build time via pbxproj variables → Info.plist → Bundle.main at runtime.
//
// Do NOT duplicate these values in Swift constants. All runtime code reads
// from Bundle.main.infoDictionary.

TRACEXY_APP_VERSION = 0.4.0
TRACEXY_APP_BUILD = 8

TRACEXY_HELPER_VERSION = 2.0.1
TRACEXY_HELPER_BUILD = 6
// Protocol v4: typed NSSecureCoding CaptureConfiguration start surface
// (interface, snap length, promiscuous mode, optional BPF) replaces protocol
// v3's bare interface request. Older helpers are classified incompatible and
// Start is gated — no fallback.
TRACEXY_HELPER_PROTOCOL_VERSION = 4
