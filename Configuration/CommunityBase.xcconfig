// CommunityBase.xcconfig — Public Community shipping identity.
//
// Keeps the current public Tracexy bundle namespace and helper caller
// allowlist, while leaving TracexyBase.xcconfig free to describe the
// generic product identity shared by downstream variants.

#include "TracexyBase.xcconfig"

TRACEXY_APP_BUNDLE_ID = $(TRACEXY_FAMILY_NAMESPACE).community
TRACEXY_APP_NAMESPACE = $(TRACEXY_APP_BUNDLE_ID)
TRACEXY_LOG_SUBSYSTEM = $(TRACEXY_APP_NAMESPACE)
TRACEXY_DEFAULTS_PREFIX = $(TRACEXY_APP_NAMESPACE)
TRACEXY_NOTIFICATION_PREFIX = $(TRACEXY_APP_NAMESPACE)
TRACEXY_APP_SUPPORT_DIRECTORY_NAME = $(TRACEXY_APP_NAMESPACE)
TRACEXY_ALLOWED_CALLER_IDENTIFIERS = $(TRACEXY_APP_BUNDLE_ID) $(TRACEXY_FAMILY_NAMESPACE)
