          }
        }
      }
    },
    "The protocol banner": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Banner giao thức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议横幅"
          }
        }
      }
    },
    "The saved capture source is unavailable.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nguồn bản ghi đã lưu không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的抓包来源不可用。"
          }
        }
      }
    },
    "The session contains a link type that cannot be represented by pcapng.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phiên có một kiểu liên kết mà pcapng không biểu diễn được."
          }
        },
        "zh-Hans": {
