            "state": "translated",
            "value": "此会话的数据包帧已不在本地导出窗口中。"
          }
        }
      }
    },
    "The payload type's clock rate is not known, so jitter cannot be measured": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không biết tần số xung nhịp của loại payload nên không đo được jitter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
