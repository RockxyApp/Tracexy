          "stringUnit": {
            "state": "translated",
            "value": "此文件不包含被接受的帧。"
          }
        }
      }
    },
    "This frame cannot be opened from the current source.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể mở khung này từ nguồn hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从当前来源打开此帧。"
          }
