    "Enable libpcap’s BPF optimizer for capture filters on this interface. Turn it off only to work around optimizer incompatibilities.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật bộ tối ưu BPF của libpcap cho bộ lọc bắt gói trên giao diện này. Chỉ tắt khi cần khắc phục vấn đề tương thích của bộ tối ưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此网络接口上的抓包过滤器启用 libpcap 的 BPF 优化器。仅在需要规避优化器不兼容问题时才关闭。"
          }
        }
      }
    },
    "Optimize BPF": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tối ưu hóa BPF"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优化 BPF"
          }
        }
      }
    },
    "Optimize BPF for %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tối ưu hóa BPF cho %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %@ 优化 BPF"
          }
        }
      }
