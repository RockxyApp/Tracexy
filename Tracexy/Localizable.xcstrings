      }
    },
    "These protections apply to .tracexysession documents. Mask IP addresses also applies to Export Investigation files and saved History. Raw pcap and pcapng exports preserve captured bytes and always require confirmation while a protection is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các bảo vệ này áp dụng cho tài liệu .tracexysession. Che địa chỉ IP cũng áp dụng cho các tệp Xuất điều tra và Lịch sử đã lưu. Xuất pcap và pcapng thô giữ nguyên byte đã bắt và luôn yêu cầu xác nhận khi một bảo vệ đang bật."
          }
        }
      }
    },
    "This Project already holds %@ notes. Clear one to add another.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dự án này đã có %@ ghi chú. Hãy xóa một ghi chú để thêm ghi chú khác."
          }
        }
      }
    },
    "This Project already names %lld subnets.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dự án này đã đặt tên cho %lld mạng con."
          }
        }
      }
    },
    "This Project has %lld tabs. New tabs can be added up to %lld per Project, so the tabs closed now cannot all be added back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Project này có %lld tab. Mỗi Project chỉ có thể thêm tab mới đến %lld, nên không thể thêm lại tất cả các tab đóng lúc này."
          }
        }
      }
    },
    "This capture contains a time outside the range supported by this export format. Save the original capture to preserve it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản bắt này chứa một thời điểm nằm ngoài phạm vi định dạng xuất hỗ trợ. Hãy lưu bản bắt gốc để giữ nguyên."
          }
        }
      }
    },
    "This capture contains no sessions.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản bắt này không có phiên."
          }
        }
      }
    },
    "This capture ended without a persisted session summary.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản bắt này kết thúc mà không có tóm tắt phiên được lưu."
          }
        }
      }
    },
    "This capture file records no time for these frames.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp bản bắt này không ghi thời gian cho các khung này."
          }
        }
      }
    },
    "This capture has more session traffic than the in-view series keeps; it may read low.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản bắt này có nhiều lưu lượng phiên hơn mức chuỗi trong-phạm-vi giữ lại; giá trị có thể thấp hơn thực tế."
          }
        }
      }
    },
    "This capture recorded no time for these frames.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản bắt này không ghi thời gian cho các khung này."
          }
        }
      }
    },
    "This capture's own time is unknown, so this is when it was opened.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thời gian riêng của bản bắt này không rõ, nên đây là thời điểm nó được mở."
          }
        }
      }
    },
    "This database uses a format version Tracexy can’t read.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cơ sở dữ liệu này dùng phiên bản định dạng mà Tracexy không đọc được."
          }
        }
      }
    },
    "This expression is checked when capture starts.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biểu thức này được kiểm tra khi bắt đầu bắt gói."
          }
        }
      }
    },
    "This file contains no named capture filters.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp này không có bộ lọc bắt gói có tên."
          }
        }
      }
    },
    "This file holds no accepted frames.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp này không có khung nào được chấp nhận."
          }
        }
      }
    },
    "This frame cannot be opened from the current source.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể mở khung này từ nguồn hiện tại."
          }
        }
      }
    },
    "This frame carries a comment in the capture file": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khung này có chú thích trong tệp bản ghi"
          }
        }
      }
    },
    "This frame carries a comment in the capture file (shown in Get Info)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khung này có chú thích trong tệp bản bắt (hiện trong Lấy thông tin)"
          }
        }
      }
    },
    "This inspector summarizes all %lld sessions in the correlated action": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trình kiểm tra này tóm tắt cả %lld phiên trong hành động liên quan"
          }
        }
      }
    },
    "This is exactly what leaves Tracexy, and it goes only to the local endpoint below. No packet bytes, payload bodies, URLs, file paths or credentials are included. The optional Host field can contain a DNS- or SNI-derived display name.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây chính xác là những gì rời khỏi Tracexy, và chỉ tới điểm cuối cục bộ bên dưới. Không có byte gói, nội dung payload, URL, đường dẫn tệp hay thông tin đăng nhập. Trường Host tùy chọn có thể chứa tên hiển thị lấy từ DNS hoặc SNI."
          }
        }
      }
    },
    "This is the location inside the Tracexy app on your Mac. Copying the client configuration inserts the full path to this installation so your MCP client can launch it. That path may include your Mac account name: keep the copied JSON in your local client settings and copy it again if you move the app.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây là vị trí bên trong ứng dụng Tracexy trên máy Mac của bạn. Sao chép cấu hình client sẽ chèn đường dẫn đầy đủ tới bản cài này để client MCP khởi chạy được. Đường dẫn đó có thể chứa tên tài khoản Mac của bạn: hãy giữ JSON đã sao chép trong cài đặt client cục bộ và sao chép lại nếu bạn di chuyển ứng dụng."
          }
        }
      }
    },
    "This is the session's first frame in the list.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây là frame đầu của phiên trong danh sách."
          }
        }
      }
    },
    "This is the session's last frame in the list.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây là frame cuối của phiên trong danh sách."
          }
        }
      }
    },
    "This isn’t a MaxMind database (.mmdb) file.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây không phải tệp cơ sở dữ liệu MaxMind (.mmdb)."
          }
        }
      }
    },
    "This isn’t a valid Session Expression.": {
      "localizations": {
