        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按主机可将范围缩小至其会话"
          }
        }
      }
    },
    "Double-click a packet to open its frame.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhấp đúp vào một gói để mở khung của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按数据包可打开其帧。"
          }
        }
      }
    },
    "Double-click a row to select the session carrying its slowest measurement": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bấm đúp vào một hàng để chọn phiên có số đo chậm nhất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按一行可选择包含其最慢测量值的会话"
          }
        }
      }
    },
    "Double-click an app to narrow the scope to its sessions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bấm đúp vào một ứng dụng để thu hẹp phạm vi về các phiên của nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按应用可将范围缩小至其会话"
          }
        }
      }
    },
    "Download verified updates in the background so they are ready to install.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tải các bản cập nhật đã xác minh ở nền để sẵn sàng cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台下载经过验证的更新，以便随时安装。"
          }
        }
      }
    },
    "Draw each value as a dot, or join them with a line": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
