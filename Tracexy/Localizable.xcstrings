    "%@ contains %lld workspace(s), user-authored filter text, and layout preferences. It contains no captured traffic, payloads, local file paths, findings, or History. Existing Projects will not be replaced.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ chứa %lld không gian làm việc, văn bản bộ lọc do người dùng viết và tuỳ chọn bố cục. Tệp không chứa lưu lượng đã bắt, payload, đường dẫn tệp cục bộ, phát hiện hay Lịch sử. Các Dự án hiện có sẽ không bị thay thế."
          }
        }
      }
    },
