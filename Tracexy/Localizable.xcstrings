    "Removes only local History summaries at launch, after a capture is added, and when this setting changes. Current capture data and saved files stay untouched.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ xóa các tóm tắt Lịch sử cục bộ khi mở ứng dụng, sau khi thêm một bản bắt và khi cài đặt này thay đổi. Dữ liệu bắt gói hiện tại và các tệp đã lưu được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在启动时、添加抓包后以及此设置更改时移除本地历史记录摘要。当前抓包数据和已存储的文件不受影响。"
          }
        }
      }
    },
